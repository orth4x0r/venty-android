<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's power button: a hot orange core cooling to ember at the edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FFFFB27A"
        android:centerColor="#FFFF7A3D"
        android:endColor="#FFE8452A" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
